#!/usr/bin/env zsh

# --- Host classification ---
# Development and production hostname prefixes.
DEV="ndev-"
PRO="npro-"

# --- Prompt sections ---
# Enable Git, terminal title, previous-command status, and Python virtual environments.
YAFP_REPOS=1
YAFP_TITLE=1
YAFP_ERROR=1
YAFP_PVENV=1

# --- Appearance ---
# Available themes: default, minimal, and light.
YAFP_THEME="light"

# Use darker backgrounds in default/minimal; light has no colored backgrounds.
YAFP_DARKC=1

# Display prompt timestamps; set to 0 to hide them.
YAFP_CLOCK=1

# --- Shell integration ---
# Emit OSC 133 markers so compatible terminals can group command blocks.
# Set to 0 if your terminal misbehaves.
YAFP_OSC133=1

# --- Remote repository checks ---
# Refresh the configured upstream in the background. The interval is the cache
# lifetime in seconds; set to 0 to disable remote checks.
YAFP_REMOTE_CHECK_INTERVAL=300

# Countdown style: numeric (seconds) or symbols (one emptying Braille cell).
YAFP_REMOTE_COUNTDOWN_STYLE="numeric"

# yafp-status progress bar: blocks or symbols (Braille).
YAFP_STATUS_PROGRESS_STYLE="blocks"

# --- Machine resources ---
# Sample CPU, RAM, swap, and disk capacity in the background (seconds).
# 0 disables monitoring; 30 is a suggested interval when enabled.
YAFP_RESOURCE_CHECK_INTERVAL=0

# Labels: letters (C/R/S/D) or unicode (⚙/▦/⇄/◉).
YAFP_RESOURCE_LABEL_STYLE="letters"

# Values: percent (74%) or symbols (one Braille cell based on usage).
YAFP_RESOURCE_VALUE_STYLE="percent"

# --- Session lifecycle ---
# Reload automatically when a successful git pull changes the YAFP commit.
# yafp-reload remains available when this option is disabled.
YAFP_AUTO_RELOAD=1

# Print per-session command statistics on normal shell exit.
YAFP_STATS_ON_EXIT=1

# --- Development diagnostics ---
# Display prompt construction timing; set to 0 to disable these metrics.
YAFP_DEVEL=0
