$global:DEV = 'ndev-'
$global:PRO = 'npro-'

$global:YAFP_REPOS = 1
$global:YAFP_TITLE = 1
$global:YAFP_ERROR = 1
$global:YAFP_PVENV = 1

# Use darker background variants in the default and minimal themes.
# The light theme has no colored backgrounds, so this setting does not apply.
$global:YAFP_DARKC = 1

# Display prompt timestamps; set to 0 to hide them in every theme.
$global:YAFP_CLOCK = 1

# Emit OSC 133 shell-integration markers for compatible terminals.
$global:YAFP_OSC133 = 1

# Check the configured upstream in the background. The value is the cache
# lifetime in seconds; set it to 0 to disable remote checks completely.
$global:YAFP_REMOTE_CHECK_INTERVAL = 300

# Display the remote refresh countdown as seconds (numeric) or as one
# progressively emptying Braille cell (symbols).
$global:YAFP_REMOTE_COUNTDOWN_STYLE = 'numeric'

# Display the yafp-status progress bar with blocks or Braille symbols.
$global:YAFP_STATUS_PROGRESS_STYLE = 'blocks'

# Display prompt construction timing; set it to 0 to disable the metrics.
$global:YAFP_DEVEL = 0

# Reload YAFP automatically when a successful git pull changes its commit.
# The yafp-reload command remains available when this option is disabled.
$global:YAFP_AUTO_RELOAD = 1

# Print per-session command statistics during a normal shell exit.
$global:YAFP_STATS_ON_EXIT = 1

# $global:YAFP_THEME = 'default'
# $global:YAFP_THEME = 'minimal'
$global:YAFP_THEME = 'light'
