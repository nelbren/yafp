#!/bin/bash

DEV='ndev-'
PRO='npro-'

YAFP_REPOS=1
YAFP_TITLE=1
YAFP_ERROR=1
YAFP_PVENV=1
YAFP_CLOCK=1

# Check the configured upstream in the background. The value is the cache
# lifetime in seconds; set it to 0 to disable remote checks completely.
YAFP_REMOTE_CHECK_INTERVAL=300

# Emit OSC 133 shell-integration markers so compatible terminals can group
# each command as a semantic block. Set to 0 if your terminal misbehaves.
YAFP_OSC133=1

YAFP_DEVEL=0

# YAFP_THEME="default"
# YAFP_THEME="minimal"
YAFP_THEME="light"
